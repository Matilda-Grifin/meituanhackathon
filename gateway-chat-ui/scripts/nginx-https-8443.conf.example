# 推荐：保留 8080 HTTP，新增 8443 HTTPS（手机需先信任自签证书）
# 路径：/etc/nginx/sites-available/gateway-chat-ui-https
# 启用：ln -sf .../gateway-chat-ui-https /etc/nginx/sites-enabled/

# 修复后的 HTTP（8080）— location 勿嵌套
server {
    listen 8080;
    listen [::]:8080;
    server_name _;
    root /var/www/gateway-chat-ui;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8098;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

server {
    listen 8443 ssl;
    listen [::]:8443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/ssl/gateway-chat.crt;
    ssl_certificate_key /etc/nginx/ssl/gateway-chat.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    root /var/www/gateway-chat-ui;
    index index.html;

    # 位置 API
    location /api/ {
        proxy_pass http://127.0.0.1:8098;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # OpenClaw 网关 WebSocket → 本机 18789（前端用 wss://IP:8443/ws/）
    location /ws/ {
        proxy_pass http://127.0.0.1:18789/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}

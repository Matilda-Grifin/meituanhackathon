{
  "name": "gateway-chat-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --config vite.app.config.ts --mode app",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build --config vite.app.config.ts --mode app",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:app": "vite preview --config vite.app.config.ts --outDir dist-app",
    "test:app": "playwright test scripts/e2e-app-send.spec.ts --config scripts/playwright.app.config.ts",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "mermaid": "^11.15.0",
    "openclaw-ws": "^0.1.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}

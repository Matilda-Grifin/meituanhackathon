# 复制本文件为 .env.production 后修改，再执行: npm run build
# .env.production 已加入 .gitignore，避免把 token 提交到 git。
#
# 默认网关 WebSocket（评委只打开 http://IP:8080/ 时用这个）
# 注意：若本页用 https:// 打开，浏览器会拦截 ws://（混合内容 → WebSocket closed 1006），请改用 http:// 或为网关做 wss 反代。
VITE_DEFAULT_GATEWAY_WS=ws://YOUR_PUBLIC_IP:18789
#
# 网关 token（会打进 dist JS 明文，仅内网/答辩演示）
VITE_GATEWAY_TOKEN=
#
# 可选：默认 session key（评委用 agent:main:main；优先级高于浏览器里旧的 gw.session 缓存）
VITE_DEFAULT_SESSION_KEY=
#
# true = 打开页面后自动点 Connect（需已配好 WS + token）
VITE_AUTO_CONNECT=true
#
# true = 隐藏三项输入框，只显示摘要 + 按钮（评委模式）
VITE_COMPACT_UI=true
#
# false = 隐藏底部 Debug log（评委模式）
VITE_SHOW_DEBUG=false
#
# 位置 API 根地址（留空 = 与页面同源 /api，需 Nginx 反代 gateway_context_api）
# VITE_CLIENT_CONTEXT_API=

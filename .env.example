# =============================================================================
# 黑客松 / OpenClaw 本地生活 Agent — 环境变量模板
# 用法：复制本文件为 .env 后填写真实值（不要把 .env 提交到 Git）
#   copy .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 大模型（至少配置一个主用；名称按你实际调用的 SDK 读取）
# -----------------------------------------------------------------------------
# OpenAI 兼容（含部分代理基址）
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# 阿里云通义 DashScope（若用 qwen）
DASHSCOPE_API_KEY=

# Anthropic Claude（若用）
# ANTHROPIC_API_KEY=

# 默认模型名（给自研 FastAPI 或脚本用；OpenClaw 内可能单独在 openclaw.json 配）
LLM_MODEL=qwen-turbo

# -----------------------------------------------------------------------------
# 地图 / LBS（个人开发者：高德或百度二选一为主即可）
# -----------------------------------------------------------------------------
# 高德 Web 服务 Key：https://console.amap.com/
AMAP_KEY=

# 百度地图 AK（可选）：https://lbsyun.baidu.com/
# BAIDU_MAP_AK=

# 默认城市/中心点（示例：北京天安门附近，按你 Demo 改）
DEFAULT_CITY=杭州
DEFAULT_LNG=120.153576
DEFAULT_LAT=30.266863

# -----------------------------------------------------------------------------
# 天气（可选；Open-Meteo 可无需 Key，若用和风等再填）
# -----------------------------------------------------------------------------
# QWEATHER_KEY=
# 设为 1 表示只用 Open-Meteo（无 Key）
USE_OPEN_METEO=1

# -----------------------------------------------------------------------------
# 赛题「沙盒」Mock 后端（自建 FastAPI）
# -----------------------------------------------------------------------------
# Agent / Tool 调用的根地址；本机开发常用：
MOCK_SANDBOX_BASE_URL=http://127.0.0.1:9000

# -----------------------------------------------------------------------------
# OpenClaw Gateway（仅当你的「自研网页 / 脚本」用 WebSocket 直连网关时才填）
# -----------------------------------------------------------------------------
# 多数入门用法：本机 openclaw gateway 默认 ws://127.0.0.1:18789（路径以官方文档为准，常见无后缀或 /）
# 云上：Nginx/Caddy 反代 WSS 后填 wss://你的域名/...
# TOKEN：与网关配置里 gateway.auth 的 token/password 一致（见 ~/.openclaw/openclaw.json 或你部署目录）
# 若用户只通过 OpenClaw 自带流程连网关、或你的 Demo 不手写 WS 客户端 → 整段可留空，不必硬填
# OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
# OPENCLAW_GATEWAY_TOKEN=

# -----------------------------------------------------------------------------
# Redis（可选；没有就不用装、不填）
# -----------------------------------------------------------------------------
# Redis = 内存键值数据库，常用来做缓存、会话、排队。黑客松没有完全可以不写 REDIS_URL，
# 你的代码里用 Python 字典 / 单文件缓存即可。
# 若以后要装：阿里云「云数据库 Redis」、或本机 Docker `redis:7`，地址形如：
# REDIS_URL=redis://127.0.0.1:6379/0

# -----------------------------------------------------------------------------
# 嵌入 Embedding（可选；只有启用「向量记忆 / memory_search 要单独走一套接口」时才填）
# -----------------------------------------------------------------------------
# 作用：把文字变成向量，做语义检索。OpenClaw 若用默认 memory 插件，往往跟主模型同一厂商即可。
# 「在哪拿」：与主 LLM 同一平台最省事 —— 例如：
#   - OpenAI：EMBEDDING_API_KEY=sk-... ，BASE 可留空或 https://api.openai.com/v1
#   - 通义 DashScope：用控制台 embedding 模型文档里的 endpoint + API-Key（与 DASHSCOPE_API_KEY 可共用）
#   - 本地 Ollama：BASE=http://127.0.0.1:11434/v1 ，KEY 可填占位或空（视客户端要求）
# 不做长期向量记忆、赛题只要求模拟偏好文件 → 整段留空即可
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# -----------------------------------------------------------------------------
# 关于「大众点评 / 美团」数据（.env 里通常没有单独一项）
# -----------------------------------------------------------------------------
# 大众点评、美团门店评价/排队/交易等 **不对个人开发者开放** 成「填个 Key 就能查」的公开 API。
# 比赛做法：① 高德/百度拿 POI 名称与坐标；② 评价文案/排队/订座用自建 MOCK_SANDBOX 假接口模拟；
# 勿对点评/美团做未授权抓取（合规与封号风险）。若未来有企业开放平台账号，再单独按官方文档配置，一般不放进本模板。

# -----------------------------------------------------------------------------
# 运行环境
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
